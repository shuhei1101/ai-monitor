# ai-monitor 設定サンプル（モニター / MCP 共用）
# 実運用は ~/.config/ai-monitor/settings.yaml にコピーして書き換える
# 環境差分は settings.{環境}.yaml に書き、環境名は AI_MONITOR_ENV（または --env）で指定する

# GitHub API（githubkit）の認証 PAT
# fine-grained PAT に監視対象全リポジトリの Issues / Pull requests / Contents の RW を付与
github_token: github_pat_xxxxxxxx

# POST /completions の待受ポート（bind 先は 127.0.0.1 固定）
port: 8765

# GitHub ポーリングの周期（秒）
poll_interval_sec: 15

# 処理中のまま超過したセッションを kill する閾値（分）
session_timeout_min: 30

# 生存確認の周期（秒）
heartbeat_interval_sec: 60

# 会話ログからリセット時刻を読めなかった場合に待つ時間（分）
rate_limit_fallback_min: 60

# セッション台帳の永続化先
state_path: data/state.yaml

# モニターと監視役の相互監視（丸ごと省略しても既定値で動く）
watchdog:
  enabled: true                 # false にすると監視役を起動も監視もしない
  interval_sec: 15              # 相手の生存を確認する間隔（秒）
  liveness_timeout_sec: 120     # 最終周回時刻がこの秒数より古ければ停止とみなす
  restart_window_min: 60        # 再起動の回数を数える期間（分）
  restart_max: 3                # 期間内に許す再起動の回数（超えたら通知のみ・相手ごとに別勘定）
  restarts_path: data/restarts.yaml

# 通知の送信先（複数指定可・丸ごと省略すると通知しない）
# 同じ送信先を複数登録し、events で契機を振り分けると面ごとに分けられる
notifies:
  - type: webhook              # 送出方式の判別子
    enabled: true              # false にすると設定を残したまま止められる
    name: ユーザー確認待ち     # ログと送出結果で使う表示名（省略時は {type}:{kind}）
    webhook_url: https://discord.com/api/webhooks/xxxxxxxx
    kind: discord              # discord / slack でペイロードのキーが変わる
    events:                    # 契機ごとの送出可否（書かなかった契機は送る）
      user_gate: true
      rate_limit: false
      timeout_kill: false
      epic_done: false
      defect_report: false
      monitor_down: false
      watchdog_down: false
      monitor_down: false
      watchdog_down: false

  - type: webhook
    enabled: true
    name: 死活監視
    webhook_url: https://discord.com/api/webhooks/zzzzzzzz
    kind: discord
    events:
      monitor_down: true
      watchdog_down: true
      user_gate: false
      rate_limit: false
      timeout_kill: false
      epic_done: false
      defect_report: false

  - type: webhook
    enabled: true
    name: 運用通知
    webhook_url: https://discord.com/api/webhooks/yyyyyyyy
    kind: discord
    events:
      user_gate: false         # 書かなかった契機は送るので、外す契機だけ false にすれば足りる

# ai-monitor 自身の Wiki の場所（フェーズページ・共通対応表・共通ルールの取得元）
# raw URL（https:// 始まり）またはローカル絶対パスのどちらでもよい
# ローカルを指す場合は worktree ではなくメインリポジトリを指定する
ai_monitor_wiki_base: /mnt/c/Users/shuhe/repo/ai-monitor/docs/wiki

# ai-monitor 自身の GitHub リポジトリ
ai_monitor_repo: shuhei1101/ai-monitor

# 監視対象プロジェクト（複数可）
# wiki_base は ai_monitor_wiki_base と同じく raw URL / ローカル絶対パスの両対応
projects:
  - name: myapp
    repo: owner/myapp
    local_path: /mnt/c/Users/shuhe/repo/myapp
    wiki_base: /mnt/c/Users/shuhe/repo/myapp/docs/wiki

# エージェント別の起動設定
# model の推奨は「頭を使う工程は opus / 機械的な工程は sonnet / 軽量な分類作業は haiku」
# effort は low / medium / high / xhigh / max のいずれか（省略時は high）
agents:
  intake-issue-triager:
    model: haiku            # Issue の分解・種別判定
    effort: high
  system-conductor:
    model: opus             # 構成要件の整理・エピック分割
    effort: high
  system-architect:
    model: opus             # アーキテクチャ図・docs/wiki 骨格の生成
    effort: high
  architecture-reverse-engineer:
    model: opus             # 既存コードからの現状アーキテクチャ図の起こし
    effort: high
  mock-reverse-engineer:
    model: opus             # 既存画面からの現状モックの起こし
    effort: high
  complex-scenario-reverse-engineer:
    model: opus             # 既存コードからの現状複合 UC シナリオの起こし
    effort: high
  single-scenario-reverse-engineer:
    model: opus             # 既存コードからの現状単一 UC シナリオの起こし
    effort: high
  ss-design-reverse-engineer:
    model: opus             # 既存コードからの現状結合 / モジュール構成の起こし
    effort: high
  epic-conductor:
    model: opus             # epic 要件・方針判断
    effort: high
  epic-poc-runner:
    model: opus             # PoC 実装（技術判断）
    effort: high
  mock-designer:
    model: opus             # UI 全体設計
    effort: high
  complex-scenario-writer:
    model: opus             # 複合シナリオ設計
    effort: high
  complex-scenario-tester:
    model: opus             # 統合テスト設計・トリアージ
    effort: high
  story-conductor:
    model: opus             # story 分解・判断
    effort: high
  single-scenario-writer:
    model: opus             # 単一シナリオ設計
    effort: high
  single-scenario-tester:
    model: opus             # 統合テスト設計・トリアージ
    effort: high
  subsystem-conductor:
    model: opus             # SA 分解・変更判断
    effort: high
  architect:
    model: opus             # 設計・レビュー
    effort: high
  library-poc-runner:
    model: opus             # PoC 実装（技術判断）
    effort: high
  resetter:
    model: opus             # 影響範囲分析
    effort: high
  questioner:
    model: opus             # 会話・判断
    effort: high
  tester:
    model: sonnet               # 設計書からのテスト作成（機械的）
    effort: high
  implementer:
    model: sonnet               # 設計書 + テストからの実装（機械的）
    effort: high
  quick-implementer:
    model: sonnet               # 軽微修正の直接実装（機械的）
    effort: high
