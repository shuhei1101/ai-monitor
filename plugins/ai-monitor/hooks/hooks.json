{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "_description": "constants.env の定数と settings.yaml 由来の REPO_SLUG / WIKI_BASE / AI_MONITOR_WIKI_BASE を CLAUDE_ENV_FILE 経由でセッション内に展開",
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start/load-constants.sh"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "_description": "コンパクトをブロックし、モニターへコンテキストリセット（/clear + ドキュメント送信）を要求する",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact/request_context_reset.py"
            ]
          }
        ]
      }
    ],

    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "_description": "利用上限への到達をモニターへ通知し、リセット時刻までの待機を開始させる",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop-failure/notify_rate_limit.py"
            ]
          }
        ]
      }
    ]
  }
}
